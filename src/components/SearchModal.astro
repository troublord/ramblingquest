---
// No props — triggers via .rq-search-btn click events, works on all pages
---

<div id="search-overlay" class="search-overlay" hidden>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="搜尋文章">
    <div class="search-header">
      <svg class="search-icon-sm" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="在城市裡找些什麼..."
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close" class="search-close" aria-label="關閉搜尋">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results') as HTMLElement;

  let pagefind: any = null;
  let debounceTimer: ReturnType<typeof setTimeout>;

  document.querySelectorAll('.rq-search-btn').forEach(btn => {
    btn.addEventListener('click', openModal);
  });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeModal();
  });

  overlay.addEventListener('click', (e: MouseEvent) => {
    if (e.target === overlay) closeModal();
  });

  document.getElementById('search-close')!.addEventListener('click', closeModal);

  function openModal() {
    overlay.removeAttribute('hidden');
    input.focus();
    if (!pagefind) initPagefind();
  }

  function closeModal() {
    overlay.setAttribute('hidden', '');
    input.value = '';
    resultsEl.innerHTML = '';
  }

  async function initPagefind() {
    try {
      const importFn = new Function('path', 'return import(path)');
      pagefind = await importFn('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      resultsEl.innerHTML = `<p class="search-hint">搜尋索引尚未產生<br><small>執行 <code>npm run build</code> 後可用</small></p>`;
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(doSearch, 180);
  });

  async function doSearch() {
    const q = input.value.trim();
    if (!q) { resultsEl.innerHTML = ''; return; }
    if (!pagefind) return;

    const search = await pagefind.search(q);

    if (!search.results.length) {
      resultsEl.innerHTML = `<p class="search-hint">找不到「${q}」相關文章</p>`;
      return;
    }

    const data = await Promise.all(
      search.results.slice(0, 8).map((r: any) => r.data())
    );

    resultsEl.innerHTML = data.map((r: any) => `
      <a href="${r.url}" class="search-result-item">
        <div class="search-result-title">${r.meta?.title ?? '未命名文章'}</div>
        <div class="search-result-excerpt">${r.excerpt}</div>
      </a>
    `).join('');
  }
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 11, 24, 0.60);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 15vh 20px 0;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-box {
    width: 100%;
    max-width: 640px;
    background: #0d1a2e;
    border: 1px solid rgba(245, 184, 112, 0.18);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(5, 11, 24, 0.85);
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    gap: 12px;
  }

  .search-icon-sm {
    color: rgba(230, 239, 255, 0.35);
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: #e6efff;
    font-family: "Noto Serif TC", serif;
    font-size: 15px;
    caret-color: #f5b870;
    min-width: 0;
  }

  #search-input::placeholder {
    color: rgba(230, 239, 255, 0.3);
  }

  #search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(230, 239, 255, 0.38);
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .search-close:hover {
    color: #e6efff;
  }

  .search-results {
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(245, 184, 112, 0.2) transparent;
  }

</style>

<style is:global>
  /* All rules below target dynamically injected innerHTML — must be global */

  .search-result-item {
    display: block;
    padding: 14px 20px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 2px solid transparent;
    transition: background 0.15s, border-left-color 0.15s;
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover {
    background: rgba(255, 255, 255, 0.10);
    border-left-color: rgba(230, 239, 255, 0.3);
  }

  .search-result-title {
    color: #e6efff;
    font-family: "Noto Serif TC", serif;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .search-result-excerpt {
    color: rgba(230, 239, 255, 0.52);
    font-family: "Noto Serif TC", serif;
    font-size: 12.5px;
    line-height: 1.65;
  }

  .search-hint {
    padding: 36px 20px;
    text-align: center;
    color: rgba(230, 239, 255, 0.35);
    font-family: "Noto Serif TC", serif;
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
  }

  .search-hint code {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: rgba(245, 184, 112, 0.7);
  }

  #search-results mark {
    color: #f5b870;
    background: none;
    font-weight: 600;
  }
</style>
