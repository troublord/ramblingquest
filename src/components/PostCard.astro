---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const roomLabel: Record<string, string> = {
  study: '書房', bar: '吧台', workshop: '工坊', court: '場邊',
};
const roomToCat: Record<string, string> = {
  study: 'study', bar: 'bar', workshop: 'shop', court: 'court',
};

const room = post.data.room ?? 'study';
const cat = roomToCat[room] ?? 'study';
const date = post.data.pubDate;
const dateStr = `${date.getFullYear()} / ${String(date.getMonth()+1).padStart(2,'0')} / ${String(date.getDate()).padStart(2,'0')}`;
---

<article class="post-card">
  <a class="post-card__link" href={`/blog/${post.id}/`} aria-label={post.data.title}></a>
  <div class="post-card__pin"></div>
  <div class="post-card__photo">
    <img src={post.data.heroImage ?? '/default-card-photo.webp'} alt="" loading="lazy" />
    <span class="post-card__date-stamp">{dateStr}</span>
  </div>
  <div class="post-card__meta">
    <span class={`post-card__badge ${cat}`}>{roomLabel[room]}</span>
  </div>
  <h3>{post.data.title}</h3>
  <hr class="post-card__divider" />
  <p class="post-card__excerpt">{post.data.description}</p>
  <div class="post-card__more">閱讀全文 →</div>
</article>

<style>
  .post-card {
    position: relative;
    background: linear-gradient(180deg, #f5ecd6 0%, #ede2c4 100%);
    padding: 8px 9px 14px;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 0 rgba(255,255,255,.5) inset,
      0 2px 4px rgba(0,0,0,.4),
      0 10px 24px rgba(0,0,0,.45),
      0 18px 36px rgba(0,0,0,.25);
    transition: transform .25s ease, box-shadow .25s ease;
    cursor: pointer;
  }
  .post-card::before {
    content: "";
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(140,110,60,.04) 0 1px, transparent 1px 3px),
      radial-gradient(circle at 20% 0%, rgba(255,235,180,.4), transparent 60%),
      radial-gradient(circle at 100% 100%, rgba(120,90,40,.18), transparent 50%);
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .post-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 1px 0 rgba(255,255,255,.5) inset,
      0 4px 8px rgba(0,0,0,.4),
      0 18px 32px rgba(0,0,0,.5),
      0 0 30px rgba(244,192,98,.18);
    z-index: 10;
  }

  /* pin */
  .post-card__pin {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    width: 18px; height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f5d87a 0%, #c8960a 45%, #7a5a0a 100%);
    box-shadow: 0 2px 6px rgba(0,0,0,.55), 0 0 10px rgba(244,192,98,.3);
    z-index: 3;
  }

  /* photo */
  .post-card__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.15);
  }
  .post-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-card__date-stamp {
    position: absolute; top: 6px; left: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    color: #f0e6d2;
    background: rgba(0,0,0,.55);
    padding: 2px 5px;
    letter-spacing: .05em;
    z-index: 2;
    border: 1px solid rgba(255,255,255,.08);
  }

  /* text */
  .post-card__meta {
    display: flex; align-items: center; gap: 6px;
    margin-top: 7px; margin-bottom: 2px;
  }
  .post-card__badge {
    font-family: "Noto Serif TC", serif;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    padding: 3px 10px;
    letter-spacing: .08em;
    border-radius: 3px;
    box-shadow: 0 1px 0 rgba(0,0,0,.2);
  }
  .post-card__badge.study   { background: #d4a05a; }
  .post-card__badge.bar     { background: #c45a7a; }
  .post-card__badge.shop    { background: #4a8fb3; }
  .post-card__badge.court   { background: #6a9b5e; }

  .post-card h3 {
    font-family: "Noto Serif TC", serif;
    font-weight: 600;
    font-size: 20px;
    color: #2b2418;
    line-height: 1.4;
    letter-spacing: .02em;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card__divider {
    border: none;
    border-top: 1px dashed rgba(120,90,40,.3);
    margin: 10px 0;
  }
  .post-card__excerpt {
    font-size: 12px;
    line-height: 1.6;
    color: #5b4f3c;
    letter-spacing: .01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card__more {
    margin-top: auto;
    padding-top: 8px;
    font-family: "Noto Serif TC", serif;
    font-size: 13px;
    color: #c49a3a;
    letter-spacing: .05em;
  }
  .post-card:hover .post-card__more { color: #d4a05a; }

  /* link overlay */
  .post-card__link {
    position: absolute; inset: 0; z-index: 2;
  }
</style>
