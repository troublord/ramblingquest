---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../../../layouts/ArchiveLayout.astro';

export async function getStaticPaths() {
  const PAGE_SIZE = 30;
  const allPosts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const counts: Record<string, number> = { study: 0, bar: 0, workshop: 0, court: 0 };
  allPosts.forEach(p => {
    const r = p.data.room ?? 'study';
    if (r in counts) counts[r]++;
  });

  const allTags = [...new Set(allPosts.flatMap(p => p.data.tags ?? []))];
  const paths = [];

  for (const tag of allTags) {
    const tagPosts = allPosts.filter(p => (p.data.tags ?? []).includes(tag));
    const lastPage = Math.ceil(tagPosts.length / PAGE_SIZE);

    for (let page = 2; page <= lastPage; page++) {
      const start = (page - 1) * PAGE_SIZE;
      paths.push({
        params: { tag, page: String(page) },
        props: {
          posts: tagPosts.slice(start, start + PAGE_SIZE),
          counts,
          totalPosts: allPosts.length,
          currentPage: page,
          lastPage,
          prevUrl: page === 2 ? `/blog/tag/${tag}` : `/blog/tag/${tag}/p/${page - 1}`,
          nextUrl: page < lastPage ? `/blog/tag/${tag}/p/${page + 1}` : undefined,
        },
      });
    }
  }

  return paths;
}

const { posts, counts, totalPosts, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
const { tag } = Astro.params;
---

<ArchiveLayout
  currentRoom="all"
  currentTag={tag}
  posts={posts}
  counts={counts}
  totalPosts={totalPosts}
  pagination={{ prevUrl, nextUrl, currentPage, lastPage }}
/>
