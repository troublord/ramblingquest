---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';

const PAGE_SIZE = 30;

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const counts: Record<string, number> = { study: 0, bar: 0, workshop: 0, court: 0 };
allPosts.forEach(p => {
  const r = p.data.room ?? 'study';
  if (r in counts) counts[r]++;
});

const lastPage = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
---

<ArchiveLayout
  currentRoom="all"
  posts={allPosts.slice(0, PAGE_SIZE)}
  counts={counts}
  totalPosts={allPosts.length}
  pagination={{
    prevUrl: undefined,
    nextUrl: allPosts.length > PAGE_SIZE ? '/blog/p/2' : undefined,
    currentPage: 1,
    lastPage,
  }}
/>
