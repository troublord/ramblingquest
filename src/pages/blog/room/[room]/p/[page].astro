---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../../../layouts/ArchiveLayout.astro';

export async function getStaticPaths() {
  const PAGE_SIZE = 30;
  const ROOMS = ['study', 'bar', 'workshop', 'court'] as const;
  const allPosts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const counts: Record<string, number> = { study: 0, bar: 0, workshop: 0, court: 0 };
  allPosts.forEach(p => {
    const r = p.data.room ?? 'study';
    if (r in counts) counts[r]++;
  });

  const paths = [];
  for (const room of ROOMS) {
    const roomPosts = allPosts.filter(p => (p.data.room ?? 'study') === room);
    const lastPage = Math.ceil(roomPosts.length / PAGE_SIZE);

    for (let page = 2; page <= lastPage; page++) {
      const start = (page - 1) * PAGE_SIZE;
      paths.push({
        params: { room, page: String(page) },
        props: {
          posts: roomPosts.slice(start, start + PAGE_SIZE),
          counts,
          totalPosts: allPosts.length,
          currentPage: page,
          lastPage,
          prevUrl: page === 2 ? `/blog/room/${room}` : `/blog/room/${room}/p/${page - 1}`,
          nextUrl: page < lastPage ? `/blog/room/${room}/p/${page + 1}` : undefined,
        },
      });
    }
  }

  return paths;
}

const { posts, counts, totalPosts, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
const { room } = Astro.params;
---

<ArchiveLayout
  currentRoom={room as 'study' | 'bar' | 'workshop' | 'court'}
  posts={posts}
  counts={counts}
  totalPosts={totalPosts}
  pagination={{ prevUrl, nextUrl, currentPage, lastPage }}
/>
