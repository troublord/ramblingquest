---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/homepage.css';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Noto+Serif+TC:wght@400;500;600;700&family=DotGothic16&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>

  <body data-mood="night" data-flicker="on" data-paper="cream" data-bg="street">

    <!-- ───────── NAVBAR ───────── -->
    <nav class="rq-nav">
      <a href="/" class="rq-brand" aria-label="Rambling Quest 首頁">
        <img src="/feet-golden-blue.png" alt="" aria-hidden="true" style="height:36px;width:auto;" />
        <span class="rq-brand__text">
          <span class="rq-brand__name">Rambling Quest</span>
          <span class="rq-brand__sub">漫步的房間 · est. 2024</span>
        </span>
      </a>
      <ul class="rq-nav__links">
        <li><a href="/blog">全部文章 <span class="rq-mono">/ archive</span></a></li>
        <li><a href="/about">關於這裡 <span class="rq-mono">/ about</span></a></li>
      </ul>
      <button class="rq-nav__burger" aria-label="開啟選單" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <!-- ───────── HERO ───────── -->
    <section class="rq-hero">
      <div class="rq-city" aria-hidden="true"></div>
      <div class="rq-city__sheen" aria-hidden="true"></div>

      <div class="rq-entry">
        <div class="rq-entry__kicker">
          <span class="rq-tick"></span>
          <span>tonight · 22:47</span>
          <span class="rq-tick"></span>
        </div>
        <h1 class="rq-title">Rambling<span class="rq-title__amp"> </span>Quest</h1>
        <p class="rq-tagline">
          白天像書房，夜裡像酒館。這裡放一些我走路時撿到的想法。
        </p>
      </div>

      <ul class="rq-signs">

        <!-- 書房 -->
        <li class="rq-sign-card" data-room="study" style="--accent: 38 95% 64%; --accent2: 28 75% 50%;">
          <a href="/blog/room/study">
            <span class="rq-sign-card__bracket" aria-hidden="true"></span>
            <span class="rq-sign-card__bulb" aria-hidden="true"></span>
            <div class="rq-sign-card__board">
              <span class="rq-sign-card__cjk">書房</span>
              <span class="rq-sign-card__en">Reading · Notes · Essays</span>
            </div>
          </a>
        </li>

        <!-- 吧台 -->
        <li class="rq-sign-card" data-room="bar" style="--accent: 332 92% 66%; --accent2: 286 88% 60%;">
          <a href="/blog/room/bar">
            <span class="rq-sign-card__bracket" aria-hidden="true"></span>
            <span class="rq-sign-card__bulb" aria-hidden="true"></span>
            <div class="rq-sign-card__board rq-sign-card__board--neon">
              <span class="rq-sign-card__cjk">吧台</span>
              <span class="rq-sign-card__en">Talks · Fragments · Moods</span>
            </div>
          </a>
        </li>

        <!-- 工坊 -->
        <li class="rq-sign-card" data-room="workshop" style="--accent: 192 92% 62%; --accent2: 210 78% 55%;">
          <a href="/blog/room/workshop">
            <span class="rq-sign-card__bracket" aria-hidden="true"></span>
            <span class="rq-sign-card__bulb" aria-hidden="true"></span>
            <div class="rq-sign-card__board rq-sign-card__board--screen">
              <span class="rq-sign-card__cjk">工坊</span>
              <span class="rq-sign-card__en">Build · Code · Projects</span>
            </div>
          </a>
        </li>

        <!-- 場邊 -->
        <li class="rq-sign-card" data-room="court" style="--accent: 78 80% 60%; --accent2: 50 90% 60%;">
          <a href="/blog/room/court">
            <span class="rq-sign-card__bracket" aria-hidden="true"></span>
            <span class="rq-sign-card__bulb" aria-hidden="true"></span>
            <div class="rq-sign-card__board rq-sign-card__board--flood">
              <span class="rq-sign-card__cjk">場邊</span>
              <span class="rq-sign-card__en">Court · Body · Games</span>
            </div>
          </a>
        </li>

      </ul>
    </section>

    <!-- ───────── LATEST: photo wall on dark room background ───────── -->
    <section class="rq-wall-wrap" id="latest">
      <div class="rq-wall__scene" aria-hidden="true"></div>
      <div class="rq-wall__warm"  aria-hidden="true"></div>

      <div class="rq-wall__inner">
        <header class="rq-wall__head">
          <span class="rq-wall__rule" aria-hidden="true"></span>
          <div class="rq-wall__head-text">
            <h2 class="rq-wall__title">最新文章 <span class="rq-mono">/ recent</span></h2>
            <p class="rq-wall__sub">把想法釘起來，讓它們慢慢發酵。</p>
          </div>
        </header>

        <div class="rq-wall__cards">
          {posts.map((post) => <PostCard post={post} />)}
        </div>

        <div class="rq-wall__foot">
          <span class="rq-wall__foot-line"></span>
          <a class="rq-wall__archive" href="/blog">
            <span>瀏覽全部文章</span>
            <span class="rq-mono">→ archive</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ───────── FOOTER ───────── -->
    <footer class="rq-foot">
      <img src="/feet-golden-blue.png" alt="" aria-hidden="true" style="height:40px;width:auto;" />
      <div class="rq-foot__col rq-foot__col--note">
        <p>夜深了。記得關門。<br /><span class="rq-mono">good night, traveller.</span></p>
      </div>
      <div class="rq-foot__col rq-foot__col--links">
        <span class="rq-dot"></span>
        <a href="https://github.com/troublord" target="_blank" rel="noopener">GitHub</a>
      </div>
      <div class="rq-foot__col rq-foot__col--copy rq-mono">
        © {new Date().getFullYear()} Rambling Quest · 漫步的房間 · all rambles reserved
      </div>
    </footer>

  <script>
    const burger = document.querySelector('.rq-nav__burger') as HTMLButtonElement;
    const nav = document.querySelector('.rq-nav') as HTMLElement;
    burger?.addEventListener('click', () => {
      const open = nav.classList.toggle('rq-nav--open');
      burger.setAttribute('aria-expanded', String(open));
    });
  </script>
  </body>
</html>
