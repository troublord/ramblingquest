---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import HomeFooter from '../components/HomeFooter.astro';
import PostCard from '../components/PostCard.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_TITLE } from '../consts';
import '../styles/homepage.css';

type RoomKey = 'all' | 'study' | 'bar' | 'workshop' | 'court';

interface Props {
  currentRoom: RoomKey;
  currentTag?: string;
  posts: CollectionEntry<'blog'>[];
  counts: Record<string, number>;
  totalPosts: number;
  pagination: {
    prevUrl?: string;
    nextUrl?: string;
    currentPage: number;
    lastPage: number;
  };
}

const { currentRoom, currentTag, posts, counts, totalPosts, pagination } = Astro.props;

const roomLabel: Record<RoomKey, string> = {
  all: '全部文章',
  study: '書房',
  bar: '吧台',
  workshop: '工坊',
  court: '場邊',
};

const roomEn: Record<RoomKey, string> = {
  all: 'archive',
  study: 'reading · notes',
  bar: 'talks · moods',
  workshop: 'build · code',
  court: 'court · body',
};

const pageTitle = currentTag
  ? `#${currentTag} · ${SITE_TITLE}`
  : currentRoom === 'all'
    ? `全部文章 · ${SITE_TITLE}`
    : `${roomLabel[currentRoom]} · ${SITE_TITLE}`;

const pageDescription = currentTag
  ? `標籤 #${currentTag} 相關文章列表。`
  : currentRoom === 'all'
    ? `目前收錄 ${totalPosts} 篇文章，紀錄深夜裡的胡思亂想。`
    : `${roomLabel[currentRoom]}的文章列表，共 ${counts[currentRoom]} 篇。`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Noto+Serif+TC:wght@400;500;600;700&family=DotGothic16&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      /* ── Page wrapper: background image + grain ── */
      .ar-page {
        min-height: 100vh;
        background: #060c1a;
        position: relative;
        display: flex;
        flex-direction: column;
      }
      .ar-page::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          linear-gradient(rgba(5,11,24,0.1), rgba(5,11,24,0.1)),
          url('/night-room.webp') center/cover no-repeat;
      }
      .ar-page::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.045;
        background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='256' height='256'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='256' height='256' filter='url(%23g)'/></svg>");
        background-repeat: repeat;
        background-size: 256px;
      }

      /* ── Thin header ── */
      .ar-header {
        position: relative;
        z-index: 2;
        padding-top: 104px;
      }
      .ar-header__inner {
        padding: 0 40px;
      }
      .ar-header__title-row {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin-bottom: 24px;
        justify-content: center;
      }
      .ar-header__title-row h1 {
        font-family: "Noto Serif TC", serif;
        font-weight: 600;
        font-size: 22px;
        letter-spacing: .22em;
        color: #f0e6d2;
      }
      .ar-header__en {
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        letter-spacing: .3em;
        color: #7a6f55;
      }

      /* ── Filters ── */
      .ar-filters {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
      }
      .ar-filter {
        position: relative;
        display: block;
        padding: 11px 18px 9px;
        background: linear-gradient(180deg, rgba(15,20,35,.85), rgba(10,16,28,.92));
        border: 1px solid rgba(255,255,255,.06);
        border-top: 3px solid var(--fc, #b9a888);
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: all .25s ease;
        box-shadow: 0 4px 12px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.04);
        backdrop-filter: blur(6px);
      }
      .ar-filter::before {
        content: "";
        position: absolute;
        top: -5.5px; left: 50%;
        width: 7px; height: 7px;
        background: var(--fc, #b9a888);
        transform: translateX(-50%);
        box-shadow: 0 0 8px var(--fc-glow, rgba(185,168,136,.5));
        border-radius: 50%;
      }
      .ar-filter .fz {
        font-family: "Noto Serif TC", serif;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: .18em;
        color: var(--fc, #d8cdb0);
        display: block;
        text-shadow: 0 0 14px var(--fc-glow, rgba(185,168,136,.25));
      }
      .ar-filter .fe {
        font-family: "JetBrains Mono", monospace;
        font-size: 8.5px;
        letter-spacing: .18em;
        color: #6e6650;
        margin-top: 3px;
        text-transform: uppercase;
        display: block;
      }
      .ar-filter .cnt {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 5px 0;
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        color: var(--fc, #b9a888);
        background: rgba(255,255,255,.04);
        border: 1px solid var(--fc, #b9a888);
        border-radius: 8px;
        opacity: .75;
        vertical-align: middle;
        transform: translateY(-1px);
      }
      .ar-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(0,0,0,.55), 0 0 16px var(--fc-glow, rgba(185,168,136,.25));
      }
      .ar-filter.is-active {
        background: linear-gradient(180deg, var(--fc-soft, rgba(185,168,136,.18)), rgba(10,16,28,.95));
        border-color: var(--fc, #b9a888);
        box-shadow: 0 6px 18px rgba(0,0,0,.55), 0 0 24px var(--fc-glow, rgba(185,168,136,.5));
      }
      .ar-filter.is-active .fz { color: var(--fc-text, #f4c062); }
      .ar-filter.is-active .cnt { opacity: 1; }

      .ar-filter[data-cat="all"]      { --fc:#b9a888; --fc-glow:rgba(185,168,136,.45); --fc-soft:rgba(185,168,136,.18); --fc-text:#e8dfc0; }
      .ar-filter[data-cat="study"]    { --fc:#d4a05a; --fc-glow:rgba(212,160,90,.5);   --fc-soft:rgba(212,160,90,.20);  --fc-text:#f4c062; }
      .ar-filter[data-cat="bar"]      { --fc:#c45a7a; --fc-glow:rgba(196,90,122,.5);   --fc-soft:rgba(196,90,122,.20);  --fc-text:#f08aa6; }
      .ar-filter[data-cat="shop"]     { --fc:#4a8fb3; --fc-glow:rgba(74,143,179,.5);   --fc-soft:rgba(74,143,179,.22);  --fc-text:#7ec0e6; }
      .ar-filter[data-cat="court"]    { --fc:#6a9b5e; --fc-glow:rgba(106,155,94,.5);   --fc-soft:rgba(106,155,94,.20);  --fc-text:#8fc88a; }

      /* ── Main / grid ── */
      .ar-main {
        position: relative;
        z-index: 1;
        flex: 1;
      }
      .ar-inner {
        padding: 40px 40px 100px;
      }
      .ar-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px 20px;
        max-width: 90%;
        margin: 0 auto;
      }

      /* ── Pagination ── */
      .ar-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 28px;
        padding: 56px 0 8px;
        font-family: "JetBrains Mono", monospace;
      }
      .ar-pagination__link {
        color: #f4c062;
        text-decoration: none;
        font-size: 12px;
        letter-spacing: .1em;
        padding: 8px 18px;
        border: 1px solid rgba(244,192,98,.3);
        transition: all .2s ease;
      }
      .ar-pagination__link:hover {
        border-color: rgba(244,192,98,.8);
        box-shadow: 0 0 12px rgba(244,192,98,.25);
      }
      .ar-pagination__info {
        font-size: 11px;
        color: #7a6f55;
        letter-spacing: .2em;
      }

      /* ── Tag back link ── */
      .ar-tag-back {
        display: flex;
        justify-content: center;
        padding: 12px 0;
      }
      .ar-tag-back a {
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        letter-spacing: .15em;
        color: #b9a888;
        text-decoration: none;
        padding: 8px 18px;
        border: 1px solid rgba(185,168,136,.25);
        transition: all .2s ease;
      }
      .ar-tag-back a:hover {
        color: #f4c062;
        border-color: rgba(244,192,98,.5);
      }

      /* ── RWD ── */
      @media (max-width: 1024px) {
        .ar-grid { grid-template-columns: repeat(3, 1fr); }
      }
      @media (max-width: 768px) {
        .ar-header__inner { padding: 0 20px; }
        .ar-inner { padding: 30px 20px 80px; }
        .ar-grid { grid-template-columns: repeat(2, 1fr); }
        .ar-filters { gap: 8px; }
        .ar-filter { min-width: 80px; padding: 9px 12px 7px; }
        .ar-filter .fz { font-size: 13px; }
        .ar-filter .fe { display: none; }
        .rq-nav { padding: 0 20px !important; }
        .rq-brand__sub { display: none; }
        .rq-nav__links { gap: 20px; }
      }
      @media (max-width: 480px) {
        .ar-grid { grid-template-columns: 1fr; }
        .ar-filter { min-width: 0; flex: 0 1 calc(50% - 8px); }
        .rq-nav__links a { font-size: 12px; }
        .rq-nav__links { gap: 14px; }
      }
    </style>
  </head>

  <body data-mood="night" data-flicker="on" data-paper="cream" data-bg="street" style="background:#060c1a;" data-pagefind-ignore="all">

    <div class="ar-page">

      <!-- ── NAV ── -->
      <nav class="rq-nav" style="position:fixed; z-index:50;">
        <a href="/" class="rq-brand" aria-label="Rambling Quest 首頁">
          <img src="/feet-golden-blue.webp" alt="" aria-hidden="true" style="height:36px;width:auto;" />
          <span class="rq-brand__text">
            <span class="rq-brand__name">Rambling Quest</span>
            <span class="rq-brand__sub">漫步的房間 · est. 2024</span>
          </span>
        </a>
        <ul class="rq-nav__links">
          <li>
            <button class="rq-search-btn" aria-label="搜尋文章">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
          </li>
          <li><a href="/blog" style="color:var(--text);">全部文章 <span class="rq-mono">/ archive</span></a></li>
          <li><a href="/about">關於這裡 <span class="rq-mono">/ about</span></a></li>
        </ul>
      </nav>

      <SearchModal />

      <!-- ── Thin header ── -->
      <header class="ar-header">
        <div class="ar-header__inner">
          <div class="ar-header__title-row">
            <h1>{currentTag ? '標籤' : roomLabel[currentRoom]}</h1>
            <span class="ar-header__en">/ {currentTag ? `#${currentTag}` : roomEn[currentRoom]}</span>
          </div>

          {currentTag ? (
            <div class="ar-tag-back">
              <a href="/blog">← 全部文章</a>
            </div>
          ) : (
            <div class="ar-filters">
              <a class={`ar-filter${currentRoom === 'all' ? ' is-active' : ''}`} href="/blog" data-cat="all">
                <span class="fz">全部<span class="cnt">{totalPosts}</span></span>
              </a>
              <a class={`ar-filter${currentRoom === 'study' ? ' is-active' : ''}`} href="/blog/room/study" data-cat="study">
                <span class="fz">書房<span class="cnt">{counts.study}</span></span>
              </a>
              <a class={`ar-filter${currentRoom === 'bar' ? ' is-active' : ''}`} href="/blog/room/bar" data-cat="bar">
                <span class="fz">吧台<span class="cnt">{counts.bar}</span></span>
              </a>
              <a class={`ar-filter${currentRoom === 'workshop' ? ' is-active' : ''}`} href="/blog/room/workshop" data-cat="shop">
                <span class="fz">工坊<span class="cnt">{counts.workshop}</span></span>
              </a>
              <a class={`ar-filter${currentRoom === 'court' ? ' is-active' : ''}`} href="/blog/room/court" data-cat="court">
                <span class="fz">場邊<span class="cnt">{counts.court}</span></span>
              </a>
            </div>
          )}
        </div>
      </header>

      <!-- ── Card grid ── -->
      <main class="ar-main">
        <div class="ar-inner">
          <div class="ar-grid">
            {posts.map((post) => <PostCard post={post} />)}
          </div>

          {pagination.lastPage > 1 && (
            <nav class="ar-pagination">
              {pagination.prevUrl
                ? <a class="ar-pagination__link" href={pagination.prevUrl}>← 上一頁</a>
                : <span style="width:90px;"></span>
              }
              <span class="ar-pagination__info">{pagination.currentPage} / {pagination.lastPage}</span>
              {pagination.nextUrl
                ? <a class="ar-pagination__link" href={pagination.nextUrl}>下一頁 →</a>
                : <span style="width:90px;"></span>
              }
            </nav>
          )}
        </div>
      </main>

      <!-- ── Footer ── -->
      <HomeFooter />

    </div>

  </body>
</html>
