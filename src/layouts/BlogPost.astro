---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, room = 'study', prevPost, nextPost, headings = [] } = Astro.props;

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const hasToc = tocHeadings.length > 0;

const roomLabel: Record<string, string> = {
	study: '書房',
	bar: '吧台',
	workshop: '工坊',
	court: '場邊',
};
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Noto+Serif+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<style>
			:global(body) {
				background-color: #3d1e08;
				background-image: url('/desktop-no-paper.png');
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
				color: #2c1f14;
				font-family: "Noto Serif TC", Georgia, serif;
				font-size: 18px;
				line-height: 1.85;
				-webkit-font-smoothing: antialiased;
				margin: 0;
				padding: 0;
			}

			/* ── Nav ── */
			.rq-mono {
				font-family: "JetBrains Mono", ui-monospace, monospace;
				font-size: .78em;
				letter-spacing: .04em;
				color: rgba(230, 239, 255, .52);
				text-transform: lowercase;
			}
			.rq-nav {
				--text:      #e6efff;
				--text-soft: rgba(230, 239, 255, .78);
				--text-mute: rgba(230, 239, 255, .52);
				--halo:      255 200 120;

				position: sticky;
				top: 0;
				z-index: 50;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 14px 56px;
				background: rgba(5, 11, 24, 0.95);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border-bottom: 1px solid rgba(230, 239, 255, .07);
			}
			.rq-brand {
				display: flex;
				align-items: center;
				gap: 14px;
				white-space: nowrap;
				text-decoration: none;
			}
			.rq-brand__text {
				display: flex;
				flex-direction: column;
				line-height: 1.1;
				white-space: nowrap;
			}
			.rq-brand__name {
				font-family: "Special Elite", "Courier New", monospace;
				font-size: 18px;
				color: var(--text);
				letter-spacing: .01em;
				text-shadow: 0 1px 4px rgba(0,0,0,.6);
			}
			.rq-brand__sub {
				font-family: "JetBrains Mono", monospace;
				font-size: 10px;
				color: var(--text-mute);
				letter-spacing: .14em;
				margin-top: 3px;
			}
			.rq-nav__links {
				display: flex;
				align-items: center;
				gap: 38px;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.rq-nav__links a {
				font-family: "Noto Serif TC", serif;
				font-size: 14.5px;
				color: var(--text-soft);
				position: relative;
				padding-bottom: 4px;
				text-shadow: 0 1px 4px rgba(0,0,0,.7);
				text-decoration: none;
				transition: color .25s ease;
			}
			.rq-nav__links a .rq-mono { margin-left: 6px; color: var(--text-mute); }
			.rq-nav__links a::after {
				content: "";
				position: absolute;
				left: 0; right: 100%;
				bottom: 0; height: 1px;
				background: rgb(var(--halo) / .9);
				transition: right .35s ease;
			}
			.rq-nav__links a:hover { color: var(--text); }
			.rq-nav__links a:hover::after { right: 0; }

			/* Lamp icon */
			.rq-lamp {
				position: relative;
				width: 28px; height: 36px;
				display: inline-block;
			}
			.rq-lamp__post {
				position: absolute;
				left: 13px; top: 6px;
				width: 2px; height: 30px;
				background: linear-gradient(to bottom, #6b5a3e, #2b2418);
			}
			.rq-lamp__head {
				position: absolute;
				left: 7px; top: 4px;
				width: 14px; height: 9px;
				background: linear-gradient(to bottom, #4a3a25 0 30%, #d49a48 30% 100%);
				border-radius: 2px 2px 1px 1px;
				box-shadow: 0 0 0 1px rgba(0,0,0,.35);
			}
			.rq-lamp__glow {
				position: absolute;
				left: -12px; top: -6px;
				width: 52px; height: 32px;
				background: radial-gradient(ellipse at center,
					rgb(var(--halo) / .55) 0%,
					rgb(var(--halo) / .15) 35%,
					transparent 65%);
				filter: blur(2px);
				pointer-events: none;
			}

			/* ── Paper container ── */
			.paper-wrap {
				padding: 1.5rem 1.5rem 6rem;
			}
			.paper {
				max-width: 760px;
				margin: 0 auto;
				background: #f4e8c8;
				padding: 3.5rem 4.5rem 4rem;
				box-shadow:
					0 2px 4px rgba(60, 30, 0, 0.10),
					0 10px 28px rgba(60, 30, 0, 0.18),
					0 40px 90px rgba(60, 30, 0, 0.20);
			}
			@media (max-width: 820px) {
				.paper-wrap { padding: 1rem 0.75rem 4rem; }
				.paper { padding: 2.5rem 2rem 3rem; }
			}
			@media (max-width: 480px) {
				.paper-wrap { padding: 0.5rem 0 3rem; }
				.paper { padding: 2rem 1.25rem 2.5rem; }
			}

			/* ── Article header ── */
			.post-header {
				margin: 0 0 2rem;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.25rem;
				color: rgba(44, 31, 20, 0.55);
				font-size: 0.875rem;
				font-family: "Noto Serif TC", sans-serif;
			}
			.post-meta time {
				letter-spacing: 0.02em;
			}
			.room-badge {
				padding: 0.2em 0.8em;
				border: 1px solid rgba(245, 184, 112, .4);
				border-radius: 2rem;
				color: #f5b870;
				text-decoration: none;
				font-size: 0.8rem;
				transition: border-color 0.2s, background 0.2s;
			}
			.room-badge:hover {
				border-color: #f5b870;
				background: rgba(245, 184, 112, .08);
			}
			.room-badge[data-room="study"]       { color: hsl(38, 70%, 38%);   border-color: hsl(38deg 70% 38% / 0.4); }
			.room-badge[data-room="bar"]          { color: hsl(332, 60%, 46%); border-color: hsl(332deg 60% 46% / 0.4); }
			.room-badge[data-room="workshop"]     { color: hsl(192, 70%, 33%); border-color: hsl(192deg 70% 33% / 0.4); }
			.room-badge[data-room="court"]        { color: hsl(78, 55%, 33%);  border-color: hsl(78deg 55% 33% / 0.4); }
			.room-badge[data-room="study"]:hover    { border-color: hsl(38, 70%, 38%);   background: hsl(38deg 70% 38% / 0.08); }
			.room-badge[data-room="bar"]:hover      { border-color: hsl(332, 60%, 46%);  background: hsl(332deg 60% 46% / 0.08); }
			.room-badge[data-room="workshop"]:hover { border-color: hsl(192, 70%, 33%);  background: hsl(192deg 70% 33% / 0.08); }
			.room-badge[data-room="court"]:hover    { border-color: hsl(78, 55%, 33%);   background: hsl(78deg 55% 33% / 0.08); }
			.post-header h1 {
				font-size: 2.1rem;
				font-weight: 700;
				line-height: 1.35;
				color: #1a0f08;
				margin: 0 0 0.5rem;
				letter-spacing: -0.01em;
			}
			.last-updated {
				font-size: 0.8rem;
				color: rgba(44, 31, 20, 0.45);
				font-style: italic;
				margin-top: 0.5rem;
			}

			/* ── Hero image ── */
			.hero-image {
				margin: 0 0 2rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: 8px;
				display: block;
			}

			/* ── Prose ── */
			.prose {
				padding: 0;
			}
			.prose :global(p) {
				color: #2c1f14;
				margin-bottom: 1.5rem;
			}
			.prose :global(h2) {
				font-size: 1.45rem;
				font-weight: 700;
				color: #1a0f08;
				line-height: 1.4;
				margin: 2.5rem 0 1rem;
				scroll-margin-top: 84px;
			}
			.prose :global(h3) {
				font-size: 1.2rem;
				font-weight: 600;
				color: #1a0f08;
				line-height: 1.4;
				margin: 2rem 0 0.75rem;
				scroll-margin-top: 84px;
			}
			.prose :global(h4) {
				font-size: 1rem;
				font-weight: 600;
				color: rgba(44, 31, 20, 0.75);
				margin: 1.5rem 0 0.5rem;
			}
			.prose :global(a) {
				color: #7c3e0e;
				text-decoration: underline;
				text-underline-offset: 3px;
				text-decoration-color: rgba(124, 62, 14, 0.5);
				transition: text-decoration-color 0.2s;
			}
			.prose :global(a:hover) {
				text-decoration-color: #7c3e0e;
			}
			.prose :global(blockquote) {
				border-left: 3px solid #c9a26a;
				padding: 0.25rem 0 0.25rem 1.25rem;
				margin: 1.75rem 0;
				color: rgba(44, 31, 20, 0.55);
				font-style: italic;
			}
			.prose :global(code) {
				font-family: "JetBrains Mono", "Fira Code", monospace;
				font-size: 0.875em;
				background: rgba(44, 31, 20, 0.08);
				padding: 0.15em 0.45em;
				border-radius: 4px;
				color: #2c1f14;
			}
			.prose :global(pre) {
				background: #0d1525;
				border: 1px solid rgba(230, 239, 255, .09);
				border-radius: 8px;
				padding: 1.25rem 1.5rem;
				overflow-x: auto;
				margin: 1.75rem 0;
				line-height: 1.65;
			}
			.prose :global(pre code) {
				background: none;
				padding: 0;
				font-size: 0.875rem;
				border-radius: 0;
				color: rgba(230, 239, 255, .85);
			}
			.prose :global(img) {
				max-width: 100%;
				border-radius: 8px;
				display: block;
				margin: 1.75rem auto;
			}
			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgba(44, 31, 20, 0.15);
				margin: 2.5rem 0;
			}
			.prose :global(ul),
			.prose :global(ol) {
				color: #2c1f14;
				padding-left: 1.5rem;
				margin-bottom: 1.5rem;
			}
			.prose :global(li) {
				margin-bottom: 0.4rem;
			}
			.prose :global(strong) {
				color: #1a0f08;
				font-weight: 600;
			}
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.75rem 0;
				font-size: 0.9rem;
			}
			.prose :global(th) {
				text-align: left;
				padding: 0.6rem 1rem;
				border-bottom: 1px solid rgba(44, 31, 20, 0.2);
				color: rgba(44, 31, 20, 0.55);
				font-weight: 500;
			}
			.prose :global(td) {
				padding: 0.6rem 1rem;
				border-bottom: 1px solid rgba(44, 31, 20, 0.07);
				color: #2c1f14;
			}

			/* ── Post navigation ── */
			.post-nav {
				margin-top: 2.5rem;
				padding-top: 1.75rem;
				border-top: 1px solid rgba(44, 31, 20, 0.15);
			}
			.post-nav__back {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: rgba(44, 31, 20, 0.45);
				text-decoration: none;
				font-size: 0.875rem;
				margin-bottom: 1.75rem;
				transition: color 0.2s;
			}
			.post-nav__back:hover {
				color: #7c3e0e;
			}
			.post-nav__siblings {
				display: flex;
				gap: 1.5rem;
			}
			.post-nav__prev,
			.post-nav__next {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				text-decoration: none;
				transition: color 0.2s;
			}
			.post-nav__next {
				align-items: flex-end;
				text-align: right;
			}
			.post-nav__label {
				font-size: 0.75rem;
				color: rgba(44, 31, 20, 0.35);
				letter-spacing: 0.04em;
			}
			.post-nav__title {
				font-size: 0.9rem;
				color: rgba(44, 31, 20, 0.65);
				line-height: 1.4;
				transition: color 0.2s;
			}
			.post-nav__prev:hover .post-nav__title,
			.post-nav__next:hover .post-nav__title {
				color: #1a0f08;
			}

			/* ── Site footer ── */
			.site-footer {
				text-align: center;
				padding: 1.5rem 0 0;
				margin-top: 2rem;
				color: rgba(44, 31, 20, 0.35);
				font-size: 0.8rem;
				border-top: 1px solid rgba(44, 31, 20, 0.1);
				font-family: "Noto Serif TC", sans-serif;
			}

			/* ── TOC button ── */
			.toc-btn {
				position: fixed;
				right: 24px;
				top: 50%;
				transform: translateY(-50%);
				z-index: 60;
				width: 44px;
				height: 44px;
				border: 1px solid rgba(230, 239, 255, .15);
				border-radius: 10px;
				background: rgba(5, 11, 24, 0.52);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0;
				transition: background .2s, border-color .2s;
			}
			.toc-btn:hover {
				background: rgba(5, 11, 24, 0.96);
				border-color: rgba(255, 200, 120, .35);
			}
			.toc-btn__icon {
				display: flex;
				flex-direction: column;
				gap: 5px;
			}
			.toc-btn__icon span {
				display: block;
				width: 18px;
				height: 2px;
				background: rgba(230, 239, 255, .7);
				border-radius: 1px;
				transition: transform .25s ease, opacity .25s ease;
				transform-origin: center;
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(2) {
				opacity: 0;
				transform: scaleX(0);
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}

			/* ── TOC panel ── */
			.toc-panel {
				position: fixed;
				right: 0;
				top: 65px;
				bottom: 0;
				width: 260px;
				background: rgba(5, 11, 24, 0.52);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				border-left: 1px solid rgba(230, 239, 255, .07);
				z-index: 55;
				overflow-y: auto;
				transform: translateX(100%);
				transition: transform .3s cubic-bezier(.4, 0, .2, 1);
				padding: 1.5rem 1.25rem;
				scrollbar-width: thin;
				scrollbar-color: rgba(230, 239, 255, .12) transparent;
			}
			.toc-panel.is-open {
				transform: translateX(0);
			}
			.toc-panel__header {
				margin-bottom: 1rem;
				padding-bottom: .75rem;
				border-bottom: 1px solid rgba(230, 239, 255, .08);
			}
			.toc-panel__title {
				font-family: "JetBrains Mono", monospace;
				font-size: .72rem;
				letter-spacing: .1em;
				color: rgba(230, 239, 255, .35);
			}
			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: .2rem;
			}
			.toc-item { margin: 0; }
			.toc-depth-3 { padding-left: 1rem; }
			.toc-link {
				display: block;
				padding: .32rem .5rem;
				font-family: "Noto Serif TC", serif;
				font-size: .84rem;
				color: rgba(230, 239, 255, .5);
				text-decoration: none;
				border-radius: 4px;
				line-height: 1.5;
				border-left: 2px solid transparent;
				transition: color .2s, background .2s, border-color .2s;
			}
			.toc-link:hover {
				color: rgba(230, 239, 255, .88);
				background: rgba(230, 239, 255, .05);
			}
			.toc-link.is-active {
				color: rgb(255, 200, 120);
				border-left-color: rgb(255, 200, 120);
				background: rgba(255, 200, 120, .06);
			}

			@media (max-width: 820px) {
				.toc-btn,
				.toc-panel { display: none; }
			}
		</style>
	</head>

	<body>
		<nav class="rq-nav">
			<a href="/" class="rq-brand" aria-label="Rambling Quest 首頁">
				<img src="/feet-golden-blue.webp" alt="" aria-hidden="true" style="height:36px;width:auto;" />
				<span class="rq-brand__text">
					<span class="rq-brand__name">Rambling Quest</span>
					<span class="rq-brand__sub">漫步的房間 · est. 2024</span>
				</span>
			</a>
			<ul class="rq-nav__links">
				<li><a href="/blog">全部文章 <span class="rq-mono">/ archive</span></a></li>
				<li><a href="/about">關於這裡 <span class="rq-mono">/ about</span></a></li>
			</ul>
		</nav>

		<div class="paper-wrap">
			<div class="paper">
				<main>
					<article>
						<header class="post-header">
							<div class="post-meta">
								<FormattedDate date={pubDate} />
								<a href={`/blog/room/${room}`} class="room-badge" data-room={room}>{roomLabel[room] ?? room}</a>
							</div>
							<h1>{title}</h1>
							{updatedDate && (
								<p class="last-updated">最後更新於 <FormattedDate date={updatedDate} /></p>
							)}
						</header>

						{heroImage && (
							<div class="hero-image">
								<img src={heroImage} alt="" />
							</div>
						)}

						<div class="prose">
							<slot />
						</div>

						<footer class="post-nav">
							<a href={`/blog/room/${room}`} class="post-nav__back">
								← 返回{roomLabel[room] ?? '分類'}
							</a>
							{(prevPost || nextPost) && (
								<div class="post-nav__siblings">
									{prevPost ? (
										<a href={`/blog/${prevPost.id}`} class="post-nav__prev">
											<span class="post-nav__label">← 上一篇</span>
											<span class="post-nav__title">{prevPost.data.title}</span>
										</a>
									) : <span />}
									{nextPost ? (
										<a href={`/blog/${nextPost.id}`} class="post-nav__next">
											<span class="post-nav__label">下一篇 →</span>
											<span class="post-nav__title">{nextPost.data.title}</span>
										</a>
									) : <span />}
								</div>
							)}
						</footer>
					</article>
				</main>

				<footer class="site-footer">
					© {new Date().getFullYear()} 毓文 · Rambling Quest
				</footer>
			</div>
		</div>
		<script>
			(function () {
				const toggle = document.getElementById('toc-toggle');
				const panel = document.getElementById('toc-panel');
				if (!toggle || !panel) return;

				function open() {
					panel.classList.add('is-open');
					toggle.classList.add('is-open');
					toggle.setAttribute('aria-expanded', 'true');
					panel.setAttribute('aria-hidden', 'false');
				}
				function close() {
					panel.classList.remove('is-open');
					toggle.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
					panel.setAttribute('aria-hidden', 'true');
				}

				toggle.addEventListener('click', () => {
					panel.classList.contains('is-open') ? close() : open();
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') close();
				});


				// Smooth scroll on TOC link click
				panel.querySelectorAll('.toc-link').forEach(link => {
					link.addEventListener('click', (e) => {
						e.preventDefault();
						const target = document.getElementById(link.dataset.slug);
						if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});
				});

				// Active heading on scroll
				const headingEls = Array.from(document.querySelectorAll('.prose h2, .prose h3'));
				const links = Array.from(panel.querySelectorAll('.toc-link'));

				if (headingEls.length === 0) return;

				function updateActive() {
					const threshold = window.innerHeight * 0.25;
					let active = null;
					for (const el of headingEls) {
						if (el.getBoundingClientRect().top <= threshold) {
							active = el;
						}
					}
					const activeSlug = active ? active.id : null;
					links.forEach(l => {
						l.classList.toggle('is-active', l.dataset.slug === activeSlug);
					});
				}

				window.addEventListener('scroll', updateActive, { passive: true });
				updateActive();
			})();
		</script>

		{hasToc && (
			<>
				<button class="toc-btn" id="toc-toggle" aria-label="開啟目錄" aria-expanded="false">
					<span class="toc-btn__icon">
						<span></span>
						<span></span>
						<span></span>
					</span>
				</button>

				<nav class="toc-panel" id="toc-panel" aria-label="文章目錄" aria-hidden="true">
					<div class="toc-panel__header">
						<span class="toc-panel__title">{title}</span>
					</div>
					<ol class="toc-list">
						{tocHeadings.map(h => (
							<li class={`toc-item toc-depth-${h.depth}`}>
								<a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>{h.text}</a>
							</li>
						))}
					</ol>
				</nav>
			</>
		)}
	</body>
</html>
