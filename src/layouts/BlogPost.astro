---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SearchModal from '../components/SearchModal.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	headings?: { depth: number; slug: string; text: string }[];
	hideNav?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, room, tags = [], slug, prevPost, nextPost, headings = [], hideNav = false } = Astro.props;

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const hasToc = tocHeadings.length > 0;

const roomLabel: Record<string, string> = {
	study: '書房',
	bar: '吧台',
	workshop: '工坊',
	court: '場邊',
};

// 只有真正的文章頁（由 [...slug].astro 傳入 slug）才產生 BlogPosting structured data，about.astro 等其他用 BlogPost layout 的頁面不需要
const jsonLd = slug
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			image: new URL(heroImage ?? '/default-card-photo.webp', Astro.url).toString(),
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			author: {
				'@type': 'Person',
				name: '毓文',
			},
			mainEntityOfPage: {
				'@type': 'WebPage',
				'@id': new URL(Astro.url.pathname, Astro.site).toString(),
			},
		}
	: null;
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Noto+Serif+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=Klee+One:wght@400;600&display=swap" rel="stylesheet" />
		<style>
			:global(body) {
				background-color: #3d1e08;
				background-image: url('/desktop-no-paper.webp');
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
				color: #2c1f14;
				font-family: "Noto Serif TC", Georgia, serif;
				font-size: 18px;
				line-height: 1.85;
				-webkit-font-smoothing: antialiased;
				margin: 0;
				padding: 0;
			}

			/* ── Nav ── */
			.rq-mono {
				font-family: "JetBrains Mono", ui-monospace, monospace;
				font-size: .78em;
				letter-spacing: .04em;
				color: rgba(230, 239, 255, .52);
				text-transform: lowercase;
			}
			.rq-nav {
				--text:      #e6efff;
				--text-soft: rgba(230, 239, 255, .78);
				--text-mute: rgba(230, 239, 255, .52);
				--halo:      255 200 120;

				position: sticky;
				top: 0;
				z-index: 50;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 14px 56px;
				background: rgba(5, 11, 24, 0.95);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				border-bottom: 1px solid rgba(230, 239, 255, .07);
			}
			.rq-brand {
				display: flex;
				align-items: center;
				gap: 14px;
				white-space: nowrap;
				text-decoration: none;
			}
			.rq-brand__text {
				display: flex;
				flex-direction: column;
				line-height: 1.1;
				white-space: nowrap;
			}
			.rq-brand__name {
				font-family: "Special Elite", "Courier New", monospace;
				font-size: 18px;
				color: var(--text);
				letter-spacing: .01em;
				text-shadow: 0 1px 4px rgba(0,0,0,.6);
			}
			.rq-brand__sub {
				font-family: "JetBrains Mono", monospace;
				font-size: 10px;
				color: var(--text-mute);
				letter-spacing: .14em;
				margin-top: 3px;
			}
			.rq-nav__links {
				display: flex;
				align-items: center;
				gap: 38px;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.rq-nav__links a {
				font-family: "Noto Serif TC", serif;
				font-size: 14.5px;
				color: var(--text-soft);
				position: relative;
				padding-bottom: 4px;
				text-shadow: 0 1px 4px rgba(0,0,0,.7);
				text-decoration: none;
				transition: color .25s ease;
			}
			.rq-nav__links a .rq-mono { margin-left: 6px; color: var(--text-mute); }
			.rq-nav__links a::after {
				content: "";
				position: absolute;
				left: 0; right: 100%;
				bottom: 0; height: 1px;
				background: rgb(var(--halo) / .9);
				transition: right .35s ease;
			}
			.rq-nav__links a:hover { color: var(--text); }
			.rq-nav__links a:hover::after { right: 0; }
			.rq-search-btn {
				background: none; border: none; cursor: pointer;
				color: var(--text-soft);
				padding: 5px 6px;
				display: flex; align-items: center;
				border-radius: 4px;
				transition: color .25s ease;
				flex-shrink: 0;
			}
			.rq-search-btn:hover { color: rgb(var(--halo)); }

			/* Lamp icon */
			.rq-lamp {
				position: relative;
				width: 28px; height: 36px;
				display: inline-block;
			}
			.rq-lamp__post {
				position: absolute;
				left: 13px; top: 6px;
				width: 2px; height: 30px;
				background: linear-gradient(to bottom, #6b5a3e, #2b2418);
			}
			.rq-lamp__head {
				position: absolute;
				left: 7px; top: 4px;
				width: 14px; height: 9px;
				background: linear-gradient(to bottom, #4a3a25 0 30%, #d49a48 30% 100%);
				border-radius: 2px 2px 1px 1px;
				box-shadow: 0 0 0 1px rgba(0,0,0,.35);
			}
			.rq-lamp__glow {
				position: absolute;
				left: -12px; top: -6px;
				width: 52px; height: 32px;
				background: radial-gradient(ellipse at center,
					rgb(var(--halo) / .55) 0%,
					rgb(var(--halo) / .15) 35%,
					transparent 65%);
				filter: blur(2px);
				pointer-events: none;
			}

			/* ── Paper container ── */
			.paper-wrap {
				padding: 1.5rem 1.5rem 6rem;
			}
			.paper {
				max-width: 760px;
				margin: 0 auto;
				background: #f4e8c8;
				padding: 3.5rem 4.5rem 4rem;
				box-shadow:
					0 2px 4px rgba(60, 30, 0, 0.10),
					0 10px 28px rgba(60, 30, 0, 0.18),
					0 40px 90px rgba(60, 30, 0, 0.20);
			}
			@media (max-width: 820px) {
				.paper-wrap { padding: 1rem 0.75rem 4rem; }
				.paper { padding: 2.5rem 2rem 3rem; }
			}
			@media (max-width: 480px) {
				.paper-wrap { padding: 0.5rem 0 3rem; }
				.paper { padding: 2rem 1.25rem 2.5rem; }
			}

			/* ── Article header ── */
			.post-header {
				margin: 0 0 2rem;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.25rem;
				color: rgba(44, 31, 20, 0.55);
				font-size: 0.875rem;
				font-family: "Noto Serif TC", sans-serif;
			}
			.post-meta time {
				letter-spacing: 0.02em;
			}
			.room-badge {
				padding: 0.2em 0.8em;
				border: 1px solid rgba(245, 184, 112, .4);
				border-radius: 2rem;
				color: #f5b870;
				text-decoration: none;
				font-size: 0.8rem;
				transition: border-color 0.2s, background 0.2s;
			}
			.room-badge:hover {
				border-color: #f5b870;
				background: rgba(245, 184, 112, .08);
			}
			.room-badge[data-room="study"]       { color: hsl(38, 70%, 38%);   border-color: hsl(38deg 70% 38% / 0.4); }
			.room-badge[data-room="bar"]          { color: hsl(332, 60%, 46%); border-color: hsl(332deg 60% 46% / 0.4); }
			.room-badge[data-room="workshop"]     { color: hsl(192, 70%, 33%); border-color: hsl(192deg 70% 33% / 0.4); }
			.room-badge[data-room="court"]        { color: hsl(78, 55%, 33%);  border-color: hsl(78deg 55% 33% / 0.4); }
			.room-badge[data-room="study"]:hover    { border-color: hsl(38, 70%, 38%);   background: hsl(38deg 70% 38% / 0.08); }
			.room-badge[data-room="bar"]:hover      { border-color: hsl(332, 60%, 46%);  background: hsl(332deg 60% 46% / 0.08); }
			.room-badge[data-room="workshop"]:hover { border-color: hsl(192, 70%, 33%);  background: hsl(192deg 70% 33% / 0.08); }
			.room-badge[data-room="court"]:hover    { border-color: hsl(78, 55%, 33%);   background: hsl(78deg 55% 33% / 0.08); }
			.post-header h1 {
				font-size: 2.1rem;
				font-weight: 700;
				line-height: 1.35;
				color: #1a0f08;
				margin: 0 0 0.5rem;
				letter-spacing: -0.01em;
			}
			.last-updated {
				font-size: 0.8rem;
				color: rgba(44, 31, 20, 0.45);
				font-style: italic;
				margin-top: 0.5rem;
			}

			/* ── Hero image ── */
			.hero-image {
				margin: 0 0 2rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: 8px;
				display: block;
			}

			/* ── Prose ── */
			.prose {
				padding: 0;
			}
			.prose :global(p) {
				color: #2c1f14;
				margin-bottom: 1.5rem;
			}
			.prose :global(h2) {
				font-size: 1.45rem;
				font-weight: 700;
				color: #1a0f08;
				line-height: 1.4;
				margin: 2.5rem 0 1rem;
				scroll-margin-top: 84px;
			}
			.prose :global(h3) {
				font-size: 1.2rem;
				font-weight: 600;
				color: #1a0f08;
				line-height: 1.4;
				margin: 2rem 0 0.75rem;
				scroll-margin-top: 84px;
			}
			.prose :global(h4) {
				font-size: 1rem;
				font-weight: 600;
				color: rgba(44, 31, 20, 0.75);
				margin: 1.5rem 0 0.5rem;
			}
			.prose :global(a) {
				color: #7c3e0e;
				text-decoration: underline;
				text-underline-offset: 3px;
				text-decoration-color: rgba(124, 62, 14, 0.5);
				transition: text-decoration-color 0.2s;
			}
			.prose :global(a:hover) {
				text-decoration-color: #7c3e0e;
			}
			.prose :global(blockquote) {
				border-left: 3px solid #c9a26a;
				padding: 0.25rem 0 0.25rem 1.25rem;
				margin: 1.75rem 0;
				color: rgba(44, 31, 20, 0.55);
				font-style: italic;
			}
			.prose :global(code) {
				font-family: "JetBrains Mono", "Fira Code", monospace;
				font-size: 0.875em;
				background: rgba(44, 31, 20, 0.08);
				padding: 0.15em 0.45em;
				border-radius: 4px;
				color: #2c1f14;
			}
			.prose :global(pre) {
				background: #0d1525;
				border: 1px solid rgba(230, 239, 255, .09);
				border-radius: 8px;
				padding: 1.25rem 1.5rem;
				overflow-x: auto;
				margin: 1.75rem 0;
				line-height: 1.65;
			}
			.prose :global(pre code) {
				background: none;
				padding: 0;
				font-size: 0.875rem;
				border-radius: 0;
				color: rgba(230, 239, 255, .85);
			}
			.prose :global(img) {
				max-width: 100%;
				border-radius: 8px;
				display: block;
				margin: 1.75rem auto;
			}
			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgba(44, 31, 20, 0.15);
				margin: 2.5rem 0;
			}
			.prose :global(ul),
			.prose :global(ol) {
				color: #2c1f14;
				padding-left: 1.5rem;
				margin-bottom: 1.5rem;
			}
			.prose :global(li) {
				margin-bottom: 0.4rem;
			}
			.prose :global(strong) {
				color: #1a0f08;
				font-weight: 600;
			}
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.75rem 0;
				font-size: 0.9rem;
			}
			.prose :global(th) {
				text-align: left;
				padding: 0.6rem 1rem;
				border-bottom: 1px solid rgba(44, 31, 20, 0.2);
				color: rgba(44, 31, 20, 0.55);
				font-weight: 500;
			}
			.prose :global(td) {
				padding: 0.6rem 1rem;
				border-bottom: 1px solid rgba(44, 31, 20, 0.07);
				color: #2c1f14;
			}

			/* ── Post tags ── */
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				margin-top: 2rem;
				min-height: 1.5rem;
			}
			.post-tags__label {
				font-family: "Noto Serif TC", serif;
				font-size: 0.8rem;
				color: rgba(44, 31, 20, 0.4);
				letter-spacing: 0.04em;
				margin-right: 0.25rem;
			}
			.post-tag {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.78rem;
				color: rgba(44, 31, 20, 0.5);
				border: 1px solid rgba(44, 31, 20, 0.2);
				padding: 0.2em 0.65em;
				border-radius: 3px;
				text-decoration: none;
				letter-spacing: 0.04em;
				transition: color 0.2s, border-color 0.2s, background 0.2s;
			}
			.post-tag:hover {
				color: #7c3e0e;
				border-color: rgba(124, 62, 14, 0.4);
				background: rgba(124, 62, 14, 0.05);
			}

			/* ── Comments ── */
			.comments {
				margin-top: 2.5rem;
				padding-top: 1.75rem;
				border-top: 1px solid rgba(44, 31, 20, 0.15);
			}
			.fp-divider {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 1.5rem;
			}
			.fp-divider::before, .fp-divider::after {
				content: "";
				flex: 1;
				height: 1px;
				background-image: linear-gradient(90deg, #cbb98f 50%, transparent 50%);
				background-size: 7px 1px;
				background-repeat: repeat-x;
				opacity: 0.7;
			}
			.fp-head {
				display: flex;
				align-items: baseline;
				gap: 12px;
				margin-bottom: 4px;
			}
			.fp-head h2 {
				font-family: "Klee One", "Noto Serif TC", serif;
				font-size: 1.3rem;
				font-weight: 600;
				color: #1a0f08;
				letter-spacing: 0.05em;
				margin: 0;
			}
			.fp-en {
				font-family: "JetBrains Mono", monospace;
				font-size: 11px;
				color: rgba(44, 31, 20, 0.35);
				letter-spacing: 0.2em;
			}
			.fp-count {
				margin-left: auto;
				font-family: "JetBrains Mono", monospace;
				font-size: 12px;
				color: rgba(44, 31, 20, 0.35);
				letter-spacing: 0.05em;
			}
			.comments__list {
				display: flex;
				flex-direction: column;
				gap: 1.4rem;
				margin-bottom: 2rem;
				padding-top: 8px;
			}
			.comments__loading,
			.comments__empty {
				color: rgba(44, 31, 20, 0.45);
				font-size: 0.875rem;
				font-style: italic;
			}
			:global(.comment) {
				position: relative;
				background: linear-gradient(180deg, #fdfaf2 0%, #f9f3e4 100%);
				border: 1px solid rgba(44, 31, 20, 0.18);
				border-radius: 2px;
				padding: 1rem 1.2rem 1.1rem;
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.55) inset,
					0 6px 14px rgba(60, 40, 15, 0.10),
					0 2px 4px rgba(60, 40, 15, 0.08);
				overflow: visible;
			}
			:global(.comment:nth-child(odd))  { transform: rotate(-0.5deg); }
			:global(.comment:nth-child(even)) { transform: rotate(0.55deg); }
			:global(.comment:nth-child(odd)::after) {
				content: "";
				position: absolute;
				top: -7px;
				left: 22px;
				width: 38px;
				height: 14px;
				background: rgba(214, 196, 140, 0.45);
				box-shadow: inset 0 0 0 1px rgba(255, 245, 210, 0.4);
				transform: rotate(-4deg);
			}
			:global(.comment:nth-child(even)::after) {
				content: "";
				position: absolute;
				top: -7px;
				right: 26px;
				width: 34px;
				height: 14px;
				background: rgba(214, 196, 140, 0.40);
				box-shadow: inset 0 0 0 1px rgba(255, 245, 210, 0.4);
				transform: rotate(5deg);
			}
			:global(.comment__head) {
				display: flex;
				align-items: baseline;
				gap: 12px;
				margin-bottom: 7px;
			}
			:global(.comment__name) {
				font-family: "Klee One", "Noto Serif TC", serif;
				font-weight: 600;
				color: #1a0f08;
				font-size: 0.92rem;
				letter-spacing: 0.03em;
			}
			:global(.comment__name::after) {
				content: "";
				display: block;
				height: 2px;
				width: 100%;
				margin-top: 1px;
				background: linear-gradient(90deg, rgba(198, 154, 78, 0.55), rgba(198, 154, 78, 0.05));
				border-radius: 2px;
			}
			:global(.comment__date) {
				font-family: "JetBrains Mono", monospace;
				font-size: 10.5px;
				color: rgba(44, 31, 20, 0.42);
				letter-spacing: 0.05em;
			}
			:global(.comment__content) {
				font-size: 0.875rem;
				line-height: 1.8;
				color: rgba(44, 31, 20, 0.75);
				white-space: pre-wrap;
				word-break: break-word;
				letter-spacing: 0.01em;
				margin: 0;
			}
			:global(.comment__reply-btn) {
				margin-top: 0.6rem;
				background: none;
				border: none;
				font-family: "JetBrains Mono", monospace;
				font-size: 10px;
				letter-spacing: 0.12em;
				color: rgba(44, 31, 20, 0.32);
				cursor: pointer;
				padding: 0;
				transition: color 0.15s;
			}
			:global(.comment__reply-btn:hover) {
				color: #a87f37;
			}
			.comments__honeypot {
				position: absolute;
				left: -9999px;
				width: 1px;
				height: 1px;
				overflow: hidden;
			}
			.comments__form {
				position: relative;
				background: linear-gradient(180deg, #f8f1de 0%, #f3e8cd 100%);
				border: 1px dashed #d8c8a2;
				border-radius: 2px;
				padding: 1.375rem 1.5rem 1.25rem;
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.6) inset,
					0 8px 18px rgba(60, 40, 15, 0.10);
			}
			.comments__form::before {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				border-radius: 2px;
				background: repeating-linear-gradient(0deg, rgba(150, 120, 60, 0.02) 0 2px, transparent 2px 4px);
				mix-blend-mode: multiply;
			}
			.comments__form-head {
				display: flex;
				align-items: center;
				gap: 9px;
				font-family: "Klee One", "Noto Serif TC", serif;
				font-weight: 600;
				font-size: 0.94rem;
				color: #1a0f08;
				letter-spacing: 0.04em;
				margin-bottom: 1rem;
			}
			.comments__form-head svg { color: #a87f37; flex-shrink: 0; }
			.comments__field {
				margin-bottom: 1rem;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}
			.comments__field label {
				font-family: "JetBrains Mono", monospace;
				font-size: 10px;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: rgba(44, 31, 20, 0.45);
			}
			.comments__field input {
				font-family: "Noto Serif TC", Georgia, serif;
				font-size: 1rem;
				color: #1a0f08;
				background: transparent;
				border: none;
				border-bottom: 1.5px solid #d8c8a2;
				padding: 5px 2px 7px;
				letter-spacing: 0.02em;
				outline: none;
				transition: border-color 0.2s;
			}
			.comments__field input::placeholder {
				color: #b7a784;
				font-size: 0.875rem;
			}
			.comments__field input:focus { border-color: #c69a4e; }
			.comments__field textarea {
				font-family: "Noto Serif TC", Georgia, serif;
				font-size: 0.875rem;
				color: rgba(44, 31, 20, 0.82);
				background: rgba(255, 255, 255, 0.35);
				border: 1px solid #e2d6b6;
				border-radius: 2px;
				padding: 7px 12px;
				line-height: 1.75;
				resize: vertical;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.comments__field textarea::placeholder { color: #b7a784; }
			.comments__field textarea:focus {
				border-color: #c69a4e;
				box-shadow: 0 0 0 3px rgba(198, 154, 78, 0.12);
			}
			.comments__submit {
				border: 1px solid #a87f37;
				background: linear-gradient(180deg, #f0d79b 0%, #e6c477 100%);
				color: #5b4318;
				font-family: "Noto Serif TC", serif;
				font-weight: 600;
				font-size: 0.9rem;
				letter-spacing: 0.06em;
				padding: 9px 22px;
				border-radius: 2px;
				cursor: pointer;
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.5) inset,
					0 3px 8px rgba(120, 90, 30, 0.22);
				transition: transform 0.15s ease, box-shadow 0.15s, background 0.2s;
			}
			.comments__submit:hover {
				transform: translateY(-1.5px);
				box-shadow:
					0 1px 0 rgba(255, 255, 255, 0.5) inset,
					0 6px 14px rgba(120, 90, 30, 0.3);
				background: linear-gradient(180deg, #f3dca6 0%, #e9c980 100%);
			}
			.comments__submit:active { transform: translateY(0); }
			.comments__submit:disabled {
				opacity: 0.55;
				cursor: default;
				transform: none;
				box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4) inset;
			}
			.comments__status {
				margin: 0.6rem 0 0;
				font-family: "JetBrains Mono", monospace;
				font-size: 11.5px;
				letter-spacing: 0.06em;
				display: flex;
				align-items: center;
				gap: 7px;
				min-height: 1.2rem;
				color: rgba(44, 31, 20, 0.45);
			}
			.comments__status[data-state="loading"] { color: #a87f37; }
			.comments__status[data-state="error"]   { color: #b5644f; }
			.comments__status[data-state="success"] { color: #3e6b1f; }
			.status-dot {
				display: none;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: currentColor;
				flex-shrink: 0;
			}
			.comments__status[data-state] .status-dot { display: block; }
			.comments__status[data-state="loading"] .status-dot {
				animation: fp-pulse 1s ease-in-out infinite;
			}
			@keyframes fp-pulse {
				0%, 100% { opacity: 0.3; }
				50%       { opacity: 1; }
			}
			@media (max-width: 640px) {
				:global(.comment) { transform: none !important; }
				.comments__submit { width: 100%; text-align: center; }
			}

			/* ── Post navigation ── */
			.post-nav {
				margin-top: 2.5rem;
				padding-top: 1.75rem;
				border-top: 1px solid rgba(44, 31, 20, 0.15);
			}
			.post-nav__back {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: rgba(44, 31, 20, 0.45);
				text-decoration: none;
				font-size: 0.875rem;
				margin-bottom: 1.75rem;
				transition: color 0.2s;
			}
			.post-nav__back:hover {
				color: #7c3e0e;
			}
			.post-nav__siblings {
				display: flex;
				gap: 1.5rem;
			}
			.post-nav__prev,
			.post-nav__next {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				text-decoration: none;
				transition: color 0.2s;
			}
			.post-nav__next {
				align-items: flex-end;
				text-align: right;
			}
			.post-nav__label {
				font-size: 0.75rem;
				color: rgba(44, 31, 20, 0.35);
				letter-spacing: 0.04em;
			}
			.post-nav__title {
				font-size: 0.9rem;
				color: rgba(44, 31, 20, 0.65);
				line-height: 1.4;
				transition: color 0.2s;
			}
			.post-nav__prev:hover .post-nav__title,
			.post-nav__next:hover .post-nav__title {
				color: #1a0f08;
			}

			/* ── Site footer ── */
			.site-footer {
				text-align: center;
				padding: 1.5rem 0 0;
				margin-top: 2rem;
				color: rgba(44, 31, 20, 0.35);
				font-size: 0.8rem;
				border-top: 1px solid rgba(44, 31, 20, 0.1);
				font-family: "Noto Serif TC", sans-serif;
			}

			/* ── TOC button ── */
			.toc-btn {
				position: fixed;
				right: 24px;
				top: 50%;
				transform: translateY(-50%);
				z-index: 60;
				width: 44px;
				height: 44px;
				border: 1px solid rgba(230, 239, 255, .15);
				border-radius: 10px;
				background: rgba(5, 11, 24, 0.52);
				backdrop-filter: blur(10px);
				-webkit-backdrop-filter: blur(10px);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0;
				transition: background .2s, border-color .2s;
			}
			.toc-btn:hover {
				background: rgba(5, 11, 24, 0.96);
				border-color: rgba(255, 200, 120, .35);
			}
			.toc-btn__icon {
				display: flex;
				flex-direction: column;
				gap: 5px;
			}
			.toc-btn__icon span {
				display: block;
				width: 18px;
				height: 2px;
				background: rgba(230, 239, 255, .7);
				border-radius: 1px;
				transition: transform .25s ease, opacity .25s ease;
				transform-origin: center;
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(2) {
				opacity: 0;
				transform: scaleX(0);
			}
			.toc-btn.is-open .toc-btn__icon span:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}

			/* ── TOC panel ── */
			.toc-panel {
				position: fixed;
				right: 0;
				top: 65px;
				bottom: 0;
				width: 260px;
				background: rgba(5, 11, 24, 0.52);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				border-left: 1px solid rgba(230, 239, 255, .07);
				z-index: 55;
				overflow-y: auto;
				transform: translateX(100%);
				transition: transform .3s cubic-bezier(.4, 0, .2, 1);
				padding: 1.5rem 1.25rem;
				scrollbar-width: thin;
				scrollbar-color: rgba(230, 239, 255, .12) transparent;
			}
			.toc-panel.is-open {
				transform: translateX(0);
			}
			.toc-panel__header {
				margin-bottom: 1rem;
				padding-bottom: .75rem;
				border-bottom: 1px solid rgba(230, 239, 255, .08);
			}
			.toc-panel__title {
				font-family: "JetBrains Mono", monospace;
				font-size: .72rem;
				letter-spacing: .1em;
				color: rgba(230, 239, 255, .35);
			}
			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: .2rem;
			}
			.toc-item { margin: 0; }
			.toc-depth-3 { padding-left: 1rem; }
			.toc-link {
				display: block;
				padding: .32rem .5rem;
				font-family: "Noto Serif TC", serif;
				font-size: .84rem;
				color: rgba(230, 239, 255, .5);
				text-decoration: none;
				border-radius: 4px;
				line-height: 1.5;
				border-left: 2px solid transparent;
				transition: color .2s, background .2s, border-color .2s;
			}
			.toc-link:hover {
				color: rgba(230, 239, 255, .88);
				background: rgba(230, 239, 255, .05);
			}
			.toc-link.is-active {
				color: rgb(255, 200, 120);
				border-left-color: rgb(255, 200, 120);
				background: rgba(255, 200, 120, .06);
			}

			@media (max-width: 820px) {
				.toc-btn,
				.toc-panel { display: none; }
			}
		</style>
	</head>

	<body>
		<nav class="rq-nav">
			<a href="/" class="rq-brand" aria-label="Rambling Quest 首頁">
				<img src="/feet-golden-blue.webp" alt="" aria-hidden="true" style="height:36px;width:auto;" />
				<span class="rq-brand__text">
					<span class="rq-brand__name">Rambling Quest</span>
					<span class="rq-brand__sub">漫步的房間 · est. 2024</span>
				</span>
			</a>
			<ul class="rq-nav__links">
				<li>
					<button class="rq-search-btn" aria-label="搜尋文章">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
					</button>
				</li>
				<li><a href="/blog">全部文章 <span class="rq-mono">/ archive</span></a></li>
				<li><a href="/about">關於這裡 <span class="rq-mono">/ about</span></a></li>
			</ul>
		</nav>

		<SearchModal />

		<div class="paper-wrap">
			<div class="paper">
				<main>
					<article data-pagefind-body>
						<header class="post-header">
							<div class="post-meta">
								<FormattedDate date={pubDate} />
								{room && (
									<a href={`/blog/room/${room}`} class="room-badge" data-room={room}>{roomLabel[room] ?? room}</a>
								)}
							</div>
							<h1>{title}</h1>
							{updatedDate && (
								<p class="last-updated">最後更新於 <FormattedDate date={updatedDate} /></p>
							)}
						</header>

						{heroImage && (
							<div class="hero-image">
								<img src={heroImage} alt="" />
							</div>
						)}

						<div class="prose">
							<slot />
						</div>

						<div class="post-tags">
							{tags.length > 0 && (
								<>
									<span class="post-tags__label">標籤：</span>
									{tags.map((tag: string) => (
										<a href={`/blog/tag/${tag}`} class="post-tag">#{tag}</a>
									))}
								</>
							)}
						</div>

						{slug && (
							<section class="comments" id="comments" data-slug={slug}>
								<div class="fp-divider"></div>
								<div class="fp-head">
									<h2>留個足跡</h2>
									<span class="fp-en">/ leave a footprint</span>
									<span class="fp-count" id="fp-count"></span>
								</div>
		<div class="comments__list" id="comments-list" aria-live="polite">
									<p class="comments__loading">正在翻找紙條……</p>
								</div>
								<form class="comments__form" id="comments-form" novalidate>
									<div class="comments__honeypot" aria-hidden="true">
										<label for="comments-website">Website</label>
										<input type="text" id="comments-website" name="website" tabindex="-1" autocomplete="off" />
									</div>
									<div class="comments__form-head">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M12 19l7-7 3 3-7 7-3-3z"></path>
											<path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18z"></path>
											<path d="M2 2l7.586 7.586"></path>
											<circle cx="11" cy="11" r="2"></circle>
										</svg>
										寫下你的紙條
									</div>
									<div class="comments__field">
										<label for="comments-name">你的名字</label>
										<input type="text" id="comments-name" name="name" maxlength="60" placeholder="怎麼稱呼你呢？" required />
									</div>
									<div class="comments__field">
										<label for="comments-content">想說的話</label>
										<textarea id="comments-content" name="content" rows="3" maxlength="2000" placeholder="留下紙條" required></textarea>
									</div>
									<button type="submit" class="comments__submit">留下足跡 →</button>
									<p class="comments__status" id="comments-status" role="status"><span class="status-dot"></span></p>
								</form>
							</section>
						)}

						{!hideNav && (
							<footer class="post-nav">
								<a href={room ? `/blog/room/${room}` : '/blog'} class="post-nav__back">
									← 返回{room ? (roomLabel[room] ?? '分類') : '文章列表'}
								</a>
								{(prevPost || nextPost) && (
									<div class="post-nav__siblings">
										{prevPost ? (
											<a href={`/blog/${prevPost.id}`} class="post-nav__prev">
												<span class="post-nav__label">← 上一篇</span>
												<span class="post-nav__title">{prevPost.data.title}</span>
											</a>
										) : <span />}
										{nextPost ? (
											<a href={`/blog/${nextPost.id}`} class="post-nav__next">
												<span class="post-nav__label">下一篇 →</span>
												<span class="post-nav__title">{nextPost.data.title}</span>
											</a>
										) : <span />}
									</div>
								)}
							</footer>
						)}
					</article>
				</main>

				<footer class="site-footer">
					© {new Date().getFullYear()} 毓文 · Rambling Quest
				</footer>
			</div>
		</div>
		<script>
			(function () {
				const toggle = document.getElementById('toc-toggle');
				const panel = document.getElementById('toc-panel');
				if (!toggle || !panel) return;

				function open() {
					panel.classList.add('is-open');
					toggle.classList.add('is-open');
					toggle.setAttribute('aria-expanded', 'true');
					panel.setAttribute('aria-hidden', 'false');
				}
				function close() {
					panel.classList.remove('is-open');
					toggle.classList.remove('is-open');
					toggle.setAttribute('aria-expanded', 'false');
					panel.setAttribute('aria-hidden', 'true');
				}

				toggle.addEventListener('click', () => {
					panel.classList.contains('is-open') ? close() : open();
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') close();
				});


				// Smooth scroll on TOC link click
				panel.querySelectorAll('.toc-link').forEach(link => {
					link.addEventListener('click', (e) => {
						e.preventDefault();
						const target = document.getElementById(link.dataset.slug);
						if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});
				});

				// Active heading on scroll
				const headingEls = Array.from(document.querySelectorAll('.prose h2, .prose h3'));
				const links = Array.from(panel.querySelectorAll('.toc-link'));

				if (headingEls.length === 0) return;

				function updateActive() {
					const threshold = window.innerHeight * 0.25;
					let active = null;
					for (const el of headingEls) {
						if (el.getBoundingClientRect().top <= threshold) {
							active = el;
						}
					}
					const activeSlug = active ? active.id : null;
					links.forEach(l => {
						l.classList.toggle('is-active', l.dataset.slug === activeSlug);
					});
				}

				window.addEventListener('scroll', updateActive, { passive: true });
				updateActive();
			})();
		</script>

		<script>
			(function () {
				type Comment = { id: string; name: string; content: string; createdAt: string };

				const section = document.getElementById('comments');
				if (!section) return;

				const slug = section.dataset.slug as string;
				const list = document.getElementById('comments-list') as HTMLElement;
				const form = document.getElementById('comments-form') as HTMLFormElement;
				const status = document.getElementById('comments-status') as HTMLElement;
				if (!slug || !list || !form || !status) return;
				const submitBtn = form.querySelector('.comments__submit') as HTMLButtonElement | null;

				function escapeHtml(text: string): string {
					const div = document.createElement('div');
					div.textContent = text;
					return div.innerHTML;
				}

				function formatDate(iso: string): string {
					const d = new Date(iso);
					const y = d.getFullYear();
					const mo = String(d.getMonth() + 1).padStart(2, '0');
					const day = String(d.getDate()).padStart(2, '0');
					return `${y} / ${mo} / ${day}`;
				}

				function renderComments(comments: Comment[]) {
					const countEl = document.getElementById('fp-count');
					if (countEl) countEl.textContent = comments.length ? `${comments.length} 個足跡` : '';
					if (!comments.length) {
						list.innerHTML = '<p class="comments__empty">還沒有人留下足跡，你來當第一個？</p>';
						return;
					}
					list.innerHTML = comments.map((c: Comment) => `
						<article class="comment">
							<div class="comment__head">
								<span class="comment__name">${escapeHtml(c.name)}</span>
								<span class="comment__date">${formatDate(c.createdAt)}</span>
							</div>
							<p class="comment__content">${escapeHtml(c.content)}</p>
							<button class="comment__reply-btn" data-name="${escapeHtml(c.name)}" type="button">↩ 回覆</button>
						</article>
					`).join('');
				}

				async function loadComments() {
					try {
						const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
						const data = await res.json();
						renderComments(data.comments ?? []);
					} catch {
						list.innerHTML = '<p class="comments__empty">留言載入失敗，請重新整理頁面。</p>';
					}
				}

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					status.innerHTML = '<span class="status-dot"></span>';
					status.removeAttribute('data-state');
					if (submitBtn) submitBtn.disabled = true;
					status.innerHTML = '<span class="status-dot"></span>正在把紙條貼上去……';
					status.dataset.state = 'loading';

					const name = (form.elements.namedItem('name') as HTMLInputElement).value;
					const content = (form.elements.namedItem('content') as HTMLTextAreaElement).value;
					const website = (form.elements.namedItem('website') as HTMLInputElement).value;

					try {
						const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name, content, website }),
						});
						const data = await res.json();

						if (res.status === 201) {
							localStorage.setItem('rq_comment_name', name);
							form.reset();
							(form.elements.namedItem('name') as HTMLInputElement).value = name;
							status.innerHTML = '<span class="status-dot"></span>足跡留下了，謝謝你來過 ✦';
							status.dataset.state = 'success';
							const emptyMsg = list.querySelector('.comments__empty');
							if (emptyMsg) emptyMsg.remove();
							const article = document.createElement('article');
							article.className = 'comment';
							article.innerHTML = `
								<div class="comment__head">
									<span class="comment__name">${escapeHtml(data.comment.name)}</span>
									<span class="comment__date">${formatDate(data.comment.createdAt)}</span>
								</div>
								<p class="comment__content">${escapeHtml(data.comment.content)}</p>
								<button class="comment__reply-btn" data-name="${escapeHtml(data.comment.name)}" type="button">↩ 回覆</button>
							`;
							list.appendChild(article);
							const countEl = document.getElementById('fp-count');
							if (countEl) {
								const n = parseInt(countEl.textContent ?? '0') || 0;
								countEl.textContent = `${n + 1} 個足跡`;
							}
						} else if (res.status === 429) {
							status.innerHTML = '<span class="status-dot"></span>' + (data.error || '留言太頻繁，請稍後再試');
							status.dataset.state = 'error';
						} else {
							status.innerHTML = '<span class="status-dot"></span>' + (data.error || '紙條沒貼上，再試一次？');
							status.dataset.state = 'error';
						}
					} catch {
						status.innerHTML = '<span class="status-dot"></span>網路錯誤，請稍後再試';
						status.dataset.state = 'error';
					} finally {
						if (submitBtn) submitBtn.disabled = false;
					}
				});

				list.addEventListener('click', (e) => {
					const btn = (e.target as HTMLElement).closest('.comment__reply-btn') as HTMLButtonElement | null;
					if (!btn) return;
					const name = btn.dataset.name ?? '';
					const textarea = form.elements.namedItem('content') as HTMLTextAreaElement;
					textarea.value = `回覆 @${name}：\n`;
					form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					textarea.focus();
					textarea.setSelectionRange(textarea.value.length, textarea.value.length);
				});

				const savedName = localStorage.getItem('rq_comment_name');
				if (savedName) {
					(form.elements.namedItem('name') as HTMLInputElement).value = savedName;
				}

				loadComments();
			})();
		</script>

		{hasToc && (
			<>
				<button class="toc-btn" id="toc-toggle" aria-label="開啟目錄" aria-expanded="false">
					<span class="toc-btn__icon">
						<span></span>
						<span></span>
						<span></span>
					</span>
				</button>

				<nav class="toc-panel" id="toc-panel" aria-label="文章目錄" aria-hidden="true">
					<div class="toc-panel__header">
						<span class="toc-panel__title">{title}</span>
					</div>
					<ol class="toc-list">
						{tocHeadings.map(h => (
							<li class={`toc-item toc-depth-${h.depth}`}>
								<a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>{h.text}</a>
							</li>
						))}
					</ol>
				</nav>
			</>
		)}
	</body>
</html>
