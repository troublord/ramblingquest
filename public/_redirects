# WordPress RSS feed → Astro RSS（必須放在 /tag/* 萬用規則之前）
/feed/              /rss.xml  301
/tag/*/feed/        /rss.xml  301
/category/*/feed/   /rss.xml  301
/*/feed/            /rss.xml  301

# 舊 WordPress tag 路由 → 新 Astro tag 路由
/tag/*  /blog/tag/:splat  301

# 舊 WordPress category 路由 → blog 列表
/category/*  /blog  301

